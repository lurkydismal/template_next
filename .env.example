# Local development environment. Copy to .env and replace all example secrets.
POSTGRES_USER=template_next
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=template_next
DB_HOST=127.0.0.1
DB_PORT=5432
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DISABLE_SIGN_UP=false

# Baked into the browser bundle at build time.
NEXT_PUBLIC_GITHUB_LINK=#
