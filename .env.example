# Local development. Copy to `.env` (git-ignored). Used by `pnpm dev`, drizzle-kit and
# `docker compose -f compose.dev.yaml`. Production uses .env.production (see below).

# PostgreSQL (matches compose.dev.yaml defaults)
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=template_next
DB_HOST=127.0.0.1
DB_PORT=5432
# TLS to PostgreSQL: disable (default) | require | verify-full
# DB_SSL=disable

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: just generate-token 48
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Defaults to false outside production and true in production.
# AUTH_DISABLE_SIGN_UP=false

# Optional public link shown in the footer (compiled into the client bundle at build time)
# NEXT_PUBLIC_GITHUB_LINK=https://github.com/your/repo

# Integration tests (see README "Testing"); point at a migrated database
# TEST_DATABASE_URL=postgres://db_user:db_password@127.0.0.1:5432/template_next
