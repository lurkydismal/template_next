# Production deployment settings for compose.production.yaml.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Then fill in every `replace-with-*` value and run: just deploy-check
# Values must be shell-safe (no spaces, quotes or `$`); `openssl rand -hex 32` is ideal.

# Public hostname (no scheme, port or path). DNS must point at this host.
APP_DOMAIN=replace-with-app.your-domain.tld

# PostgreSQL identities. Keep stable once the database volume exists.
POSTGRES_ADMIN_USER=postgres
POSTGRES_DB=template_next
APP_DB_USER=template_next_app
MIGRATION_DB_USER=template_next_migrator

# Four DIFFERENT secrets of at least 32 characters: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=replace-with-generated-secret
APP_DB_PASSWORD=replace-with-generated-secret
MIGRATION_DB_PASSWORD=replace-with-generated-secret
BETTER_AUTH_SECRET=replace-with-generated-secret

# Registration is closed by default. Every account gets the same dashboard access, so only
# open it temporarily while creating the first users (docs/DEPLOYMENT.md, section 7).
AUTH_DISABLE_SIGN_UP=true

# Optional tuning
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=30000

# Optional: immutable image tags when images are built by CI instead of on the host
# APP_IMAGE=registry.example.com/template-next:1.2.3
# MIGRATOR_IMAGE=registry.example.com/template-next-migrator:1.2.3

# Optional: compiled into the client bundle at build time (rebuild to change)
# NEXT_PUBLIC_GITHUB_LINK=
