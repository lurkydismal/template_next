# Copy to .env.production on the deployment host. Never commit the real file.
APP_DOMAIN=app.example.com

# PostgreSQL bootstrap account: used only by the database image and init script.
POSTGRES_ADMIN_USER=postgres
POSTGRES_DB=template_next

# Runtime role: DML only; it cannot create or alter schema objects.
APP_DB_USER=template_next_app
# Migration role: owns schema objects and is mounted only into the migrator.
MIGRATION_DB_USER=template_next_migrator

# Generate four different secrets. See docs/DEPLOYMENT.md.
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-random-password
APP_DB_PASSWORD=replace-with-a-different-unique-random-password
MIGRATION_DB_PASSWORD=replace-with-another-unique-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Safe default. Temporarily set false only for a controlled first-user setup.
AUTH_DISABLE_SIGN_UP=true

# Connection pool size is per web container/replica.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# Compiled into the client bundle during docker build. It is not a runtime setting.
NEXT_PUBLIC_GITHUB_LINK=#

# Optional immutable image references for controlled release/rollback.
# APP_IMAGE=registry.example.com/template-next:release-2026-11-11
# MIGRATOR_IMAGE=registry.example.com/template-next-migrator:release-2026-11-11
